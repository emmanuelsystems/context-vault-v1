{
  "rewrites": [
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/index.html"
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ]
}