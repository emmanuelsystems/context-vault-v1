// vercel.json (Final Structure - SYNTACTICALLY CLEAN)
{
  "rewrites": [
    {
      "source": "/mcp/(.*)",
      "destination": "/api/mcp.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/index.html"
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  }
}