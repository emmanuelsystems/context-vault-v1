        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "exclude": [
        "web",
        "web/**",
        "node_modules"
    ]
}